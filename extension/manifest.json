{
  "manifest_version": 3,
  "name": "ChatGPT Auto-Continue",
  "version": "0.4.4",
  "description": "Independent ChatGPT follow-ups with durable receipts, bounded recovery, and per-tab diagnostic traces.",
  "browser_specific_settings": {
    "gecko": {
      "id": "auto-continue@chatdesk.local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "scripts": ["trace.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "watchdog-core.js",
        "conversation-settings.js",
        "trace.js",
        "recovery-policy.js",
        "incident-recovery.js",
        "storage.js",
        "in-page-ui.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto-Continue"
  },
  "icons": {
    "48": "icon.png",
    "96": "icon.png"
  }
}