{
    "name":  "chatdesk-lab",
    "private":  true,
    "version":  "0.1.0",
    "description":  "Independent Windows chat desktop prototype",
    "main":  "electron/main.cjs",
    "scripts":  {
                    "dev":  "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 \u0026\u0026 electron .\"",
                    "build":  "vite build",
                    "start":  "electron .",
                    "test":  "node --test tests/*.test.cjs",
                    "smoke":  "node scripts/smoke.mjs",
                    "rea":  "npx -y rea-agents@latest analyze-javascript-application dist --json",
                    "smoke:auth":  "node scripts/smoke-auth.mjs"
                },
    "dependencies":  {
                         "react":  "^19.2.0",
                         "react-dom":  "^19.2.0"
                     },
    "devDependencies":  {
                            "@vitejs/plugin-react":  "^5.2.0",
                            "concurrently":  "^9.2.1",
                            "electron":  "^39.0.0",
                            "playwright":  "^1.56.0",
                            "vite":  "^7.2.0",
                            "wait-on":  "^9.0.1"
                        },
    "allowScripts":  {
                         "electron@39.8.10":  true,
                         "esbuild@0.28.2":  true
                     }
}
